# Server only. Never prefix with VITE_. Never commit your real .env.
# Placeholder values (your_... / replace_with...) are ignored by the server.
NANSEN_API_KEY=your_nansen_api_key
PORT=4173
HOST=127.0.0.1
# Required when binding a public interface; protect telemetry with a separate
# long random secret (24+ characters). Leave blank for a local run.
ADMIN_TOKEN=
# Behind a reverse proxy: the exact public HTTPS origin, and how far to trust
# X-Forwarded-* (true, a hop count, or an Express list such as loopback).
TRUSTED_ORIGIN=
TRUST_PROXY=
# Hard upstream budgets. 0 disables live upstream calls entirely.
MAX_API_CALLS_PER_HOUR=600
MAX_API_CALLS_PER_DAY=4000
# Derived, memory-only cache (0-600). Nansen upstream caches for 10-30 minutes.
CACHE_TTL_SECONDS=600
